# Copy to .env. Never commit .env.
DATABASE_URL=postgresql://clearline:clearline@localhost:5433/clearline

# DATA_MODE: "synthetic" (dev/evals, all data fictional) or "live" (anything a real person may type).
# In live mode non-EU endpoints are refused at startup (see docs/adr/003-data-residency.md).
DATA_MODE=synthetic

# Model tiers: any OpenAI-compatible endpoint (Azure OpenAI, Anthropic's OpenAI-compatible API, DeepSeek, ...).
# REGION is declared per tier and checked against DATA_MODE.
WORKER_BASE_URL=https://api.deepseek.com/v1
WORKER_MODEL=deepseek-chat
WORKER_API_KEY=
WORKER_REGION=non-eu

DRAFTER_BASE_URL=https://api.deepseek.com/v1
DRAFTER_MODEL=deepseek-chat
DRAFTER_API_KEY=
DRAFTER_REGION=non-eu

# Optional: Langfuse (EU cloud) tracing
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Demo safety: max live (non-showcase) cases processed per day, and per-case cost cap in USD
DAILY_LIVE_CASE_LIMIT=50
